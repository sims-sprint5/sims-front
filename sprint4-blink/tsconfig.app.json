{
  "extends": "./tsconfig.node.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules", "dist", "build"],
  "compilerOptions": {
    "outDir": "./dist",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "preserve",
    "ignoreDeprecations": "5.0"
  }
}
